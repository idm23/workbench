# Rendered by install.sh — placeholders are replaced with detected values.
# Not installed directly; see install.sh.

[Unit]
Description=Workbench (__SERVICE__) on __BRANCH__
Documentation=https://github.com/idm23/workbench
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=__USER__
WorkingDirectory=__REPO__

# The venv's uvicorn is invoked directly rather than through `uv run`, so the
# service does not depend on uv being installed or on PATH at boot.
ExecStart=__REPO__/.venv/bin/uvicorn workbench.app:app --host __HOST__ --port __PORT__
# Secrets and machine-wide settings, the same file the deployer and every run
# unit read. `-` because a fresh install has no such file, and a unit that
# insisted on one would turn a missing setting into a service that will not
# start.
#
# The web process needs it for the same reason the others do, and the reason is
# worth stating because this line was missing while the others had it: it hands
# the browser the VAPID public key to subscribe with, and it calls `finish_run`
# itself when a run is cancelled or fails to start. Without it, subscribing
# silently does nothing on a machine that is configured perfectly — which is
# exactly how the pull request token failed, from the other side.
EnvironmentFile=-/etc/workbench/env
Environment=WORKBENCH_DB=__REPO__/data/workbench.db
Environment=PYTHONDONTWRITEBYTECODE=1

# Carried so the app agrees with its own units about which install it is. Two
# instances share a machine and differ only by these; a mismatch would have the
# staging deployer restarting production.
Environment=WORKBENCH_INSTANCE=__INSTANCE__
Environment=WORKBENCH_PORT=__PORT__

Restart=always
RestartSec=2

# The app only ever writes the database. ProtectSystem=strict makes the whole
# filesystem read-only, and ReadWritePaths punches through for exactly that
# directory — which is also where clones and worktrees live, so an agent doing
# its work is already covered.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=__REPO__/data

# The agent's credential and session transcripts. Runs bill a subscription,
# which means the credential is an OAuth token in the service user's home
# rather than a key in /etc/workbench/env — so this path has to be writable,
# not merely readable, because that token is refreshed periodically. Getting it
# wrong fails late and confusingly: runs work for days, then stop.
#
# Written out by install.sh rather than left as systemd's %h, which resolves to
# the manager's home — /root for a system service — regardless of User=.
ReadWritePaths=-__HOME__/.claude

# And this one, which is a separate file *beside* that directory rather than
# inside it — so an allowlist naming only .claude leaves it read-only under
# ProtectSystem=strict. The CLI writes it, and the symptom of missing it is the
# same late, confusing one described above.
ReadWritePaths=-__HOME__/.claude.json

[Install]
WantedBy=multi-user.target
