# Rendered by install.sh into /etc/systemd/user/ — a *user* unit, not a system
# one, because Steam and Sunshine have to run inside the gaming account's own
# session rather than root's. A user unit implicitly runs as whoever's
# systemd --user instance loaded it; there is no User= to set here the way
# there is in workbench-gaming.service.template.
#
# Started without anyone logging in via `loginctl enable-linger __GAMING_USER__`
# plus `systemctl --user enable --now`, run as that account (see
# `install.run_as_account`) — the same trick that keeps a user's crontab-style
# services alive after they log out, used here to mean "never logged in yet."
#
# TODO: verify against real hardware. Running Xorg as an unprivileged user
# outside a display manager's usual logind/session-permission dance is the
# part of this file most likely to need adjustment on the actual box — it may
# need `Xorg.wrap`'s setuid path, explicit `seat`/`logind` session properties,
# or a capability grant for DRM access that this unit does not yet declare.

[Unit]
Description=Workbench: a render surface for Steam and Sunshine to capture
After=graphical-session-pre.target

[Service]
Type=simple
ExecStart=/usr/bin/X :0 vt7 -nolisten tcp -config /etc/X11/xorg.conf.d/10-workbench-dummy.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
