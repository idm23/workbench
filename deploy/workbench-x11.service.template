# Rendered by install.sh into /etc/systemd/system/ — a system unit, run as
# root, and root is not a narrow-privilege default here: it is the actual
# requirement. Verified against real hardware: this Ubuntu build ships no
# setuid `Xorg.wrap` at all (`/usr/lib/xorg/Xorg` is a plain root-owned
# binary), and `/dev/tty7` is `crw-------` — zero permission bits for anyone
# but root, `tty`-group membership included. A `systemd --user` unit was tried
# first and cannot work *by construction*, independent of any of that: a user
# unit always runs as whoever's own systemd instance loaded it, so it can
# never be root, and there is no ACL or capability grant that substitutes
# because this account has no real logind session/seat to attach one to
# (`loginctl enable-linger` keeps a user manager alive with nobody logged in;
# it does not fabricate a console session for it).
#
# Steam and Sunshine still run as the gaming account, unaffected: they are X
# *clients*, connecting to :0 over the usual local socket. A root X server
# with unprivileged clients is the ordinary, decades-old shape of this, not a
# workaround — display managers and logind sessions exist to automate exactly
# this split for a desktop with a real login, which this machine has none of.

[Unit]
Description=Workbench: a render surface for Steam and Sunshine to capture
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/X :0 vt7 -nolisten tcp -config /etc/X11/xorg.conf.d/10-workbench-dummy.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
